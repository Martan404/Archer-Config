#! /bin/bash

# Archer Arrow
# NAME: Local file sharing
# DESC: Share files locally using copyparty

current_user=$USER

show_info "Installing copyparty packages"
paru -S --needed copyparty cfssl ffmpeg python-pillow python-argon2-cffi  # python-pyopenssl

mkdir -p "${HOME}"/.config/copyparty/logs/
mkdir -p "${HOME}"/Share/Upload

while true; do
    read -rsp "Admin password: " password1
    echo
    read -rsp "Confirm password: " password2
    echo

    if [[ "$password1" != "$password2" ]]; then
        show_info "Passwords do not match. Please try again"
        password1=""
        password2=""
        continue
    fi

    HASH=$(copyparty --ah-alg argon2 --ah-gen "$password1" | tail -n1)
    password1=""
    password2=""
    break
done

if ! grep -q '^share()' ~/.bash_aliases; then
cat >> ~/.bash_aliases <<EOF

share-file() {
    ln "\$1" "\$HOME/Share/"  && echo "Shared to \$HOME/Share/"
}
alias share-file='share-file'
EOF
fi

cat > "$HOME/.config/copyparty/copyparty.conf" <<EOF
[global]
  # p: 80,443,3923          # listen on 80/443 as well (requires CAP_NET_BIND_SERVICE)
  # i: 127.0.0.1            # only allow connections from localhost (reverse-proxies)
  # ftp: 3921               # enable ftp server on port 3921 (needs python-pyopenssl)
  # p: 3939                 # listen on another port
  # df: 16                  # stop accepting uploads if less than 16 GB free disk space
  # ver                     # show copyparty version in the controlpanel
  # grid                    # show thumbnails/grid-view by default
  # theme: 2                # monokai
  # name: datasaver         # change the server-name that's displayed in the browser
  # stats, nos-dup          # enable the prometheus endpoint, but disable the dupes counter (too slow)
  # no-robots, force-js     # make it harder for search engines to read your server
 
  e2dsa                     # enable file indexing and filesystem scanning
  e2ts                      # and enable multimedia indexing
  ansi                      # and colors in log messages
  z, qr                     # and zeroconf and qrcode (you can comma-separate arguments)
  ah-alg: argon2            # enables password hashing

  i: 0.0.0.0
  no-robots
  force-js

  # disable logging to stdout/journalctl and log to a file instead;
  # \$LOGS_DIRECTORY is usually /var/log/copyparty (comes from systemd)
  # and copyparty replaces %Y-%m%d with Year-MonthDay, so the
  # full path will be something like /var/log/copyparty/2023-1130.txt
  # (note: enable compression by adding .xz at the end)
  #q, lo: /dev/null     # Disable logs
  q, lo: \${HOME}/.config/copyparty/logs/%Y-%m%d.log

  # this is not needed when using the arch package
  # enable version-checker by uncommenting one of the 'vc-url' lines below; this will
  # periodically check if your copyparty version has a known security vulnerability,
  # showing a warning on /?h (control-panel) for all users with permission 'a' or 'A'
  #vc-url: https://api.github.com/repos/9001/copyparty/security-advisories?per_page=9
  #vc-url: https://api.copyparty.eu/advisories
  #vc-age: 3  # how many hours to wait between each version-check
  #vc-exit  # emergency-exit if a version-check indicates that the current version is vulnerable

[accounts]
# username: password
  admin: ${HASH}

[/]
  /home/\${USER}/Share
  accs:
    r: *
    rwdma: admin
  flags:
    grid

[/copyparty-manager]
  /home/\${USER}/Share/copyparty-manager
  flags:
    unlistcr
    unlistcw
    unlist

[/Upload]
  /home/\${USER}/Share/Upload
  accs:
    w: *
    rwdma: admin
  flags:
    grid
EOF
HASH=""

cat > "$HOME/.local/bin/copyparty-manager" <<EOF
#!/usr/bin/bash

SERVICE="copyparty"

clear
while true; do

    if systemctl --user is-active --quiet "\$SERVICE"; then
        echo "=== \$SERVICE is RUNNING ==="
        echo
        echo "1) Restart"
        echo "2) Disable"
        echo "3) Status"
        echo "4) Journal"
        echo "5) Logs"
        echo "6) Exit"
        echo
        read -rp "Choice: " choice
        clear

        case "\$choice" in
            1)
                if systemctl --user restart "\$SERVICE"; then
                    echo "\$SERVICE restarted."
                else
                    echo "Failed to restart \$SERVICE."
                fi
                echo
                ;;
            2)
                if systemctl --user disable --now "\$SERVICE"; then
                    echo "\$SERVICE disabled and stopped."
                else
                    echo "Failed to disable \$SERVICE."
                fi
                echo
                ;;
            3)
                systemctl --user status "\$SERVICE" -l --no-pager
                echo
                echo "--- End of status ---"
                echo
                ;;
            4)
                journalctl --user --user-unit="\$SERVICE" -n 100 --no-pager
                echo
                echo "--- End of journal ---"
                echo
                ;;
            5)
                tail -n +1 -F "\$(find "\${HOME}/.config/copyparty/logs" -name "\$(date +%Y-%m%d).log*" -type f | sort -V | tail -n1)" &
                tail_pid=\$!
                trap 'kill "\$tail_pid"' INT
                wait "\$tail_pid"
                echo
                ;;
            6)
                clear
                exit 0
                ;;
            *)
                echo "Invalid choice."
                echo
                ;;
        esac

    else
        echo "=== \$SERVICE is NOT RUNNING ==="
        echo
        echo "1) Enable"
        echo "2) Status"
        echo "3) Journal"
        echo "4) Logs"
        echo "5) Exit"
        echo
        read -rp "Choice: " choice
        clear

        case "\$choice" in
            1)
                if systemctl --user enable --now "\$SERVICE"; then
                    echo "\$SERVICE enabled and started."
                else
                    echo "Failed to enable \$SERVICE."
                fi
                echo
                ;;
            2)
                systemctl --user status "\$SERVICE" -l --no-pager
                echo
                echo "--- End of status ---"
                echo
                ;;
            3)
                journalctl --user --user-unit="\$SERVICE" -n 100 --no-pager
                echo
                echo "--- End of journal ---"
                echo
                ;;
            4)
                tail -n +1 -F "\$(find "\${HOME}/.config/copyparty/logs" -name "\$(date +%Y-%m%d).log*" -type f | sort -V | tail -n1)" &
                tail_pid=\$!
                trap 'kill "\$tail_pid"' INT
                wait "\$tail_pid"
                echo
                ;;
            5)
                clear
                exit 0
                ;;
            *)
                echo "Invalid choice."
                echo
                ;;
        esac
    fi
done
EOF

chmod +x "$HOME/.local/bin/copyparty-manager"

ln "$HOME/.local/bin/copyparty-manager" "$HOME/Share/"

#systemctl --user enable --now copyparty
show_success "Copyparty is now installed and configured"
show_info "The service can be started and managed running 'copyparty-manager' in a terminal"
show_info "Tip! Go to any folder and run copyparty to share that directory temporarily"
show_info "Or use the alias 'share-file <file-name>' to create a symlink in the ~/Share directory"
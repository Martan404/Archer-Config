#! /bin/bash

# Archer Configuration Toolkit is a modular and easy way to setup and configure different parts of your Arch Linux system
# Select one or more arrows from the quiver and Archer Configuration Toolkit will install and configure features for your system automatically

REPO="Martan404/Archer-Config"
BRANCH="main"

TMP_DIR="$(mktemp -d)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_NAME="$(basename "$0")"
QUIVER="${SCRIPT_DIR}/quiver"

declare -A repo_files
declare -A local_files
declare -A file_status

trap 'rm -rf "$TMP_DIR"' EXIT

# Helper function
show_info() {
    echo "$(tput setaf 4)$(tput bold)> $*$(tput sgr0)"
}
export -f show_info

# Source bash-tui-toolkit
if ! [[ -f $SCRIPT_DIR/bash-tui-toolkit.bash ]]; then
    if ! curl -fsSL https://bash-tui-toolkit.timo-reymann.de/latest/bundle.bash -o "$SCRIPT_DIR/bash-tui-toolkit.bash"; then
        echo "Failed downloading bash-tui-toolkit"
        exit 1
    fi
fi
source "$SCRIPT_DIR/bash-tui-toolkit.bash"

# Export bash-tui-toolkit functions for arrows to use
mapfile -t toolkit_functions < <(
    declare -F | awk '{print $3}'
)
export -f "${toolkit_functions[@]}"

# Download and prepare update
echo "Updating Archer Configuration Toolkit..."

mkdir "$TMP_DIR/repo"

curl -fsSL "https://github.com/$REPO/archive/refs/heads/$BRANCH.tar.gz" -o "$TMP_DIR/repo.tar.gz"

tar -xzf "$TMP_DIR/repo.tar.gz" --strip-components=1 -C "$TMP_DIR/repo"


# Check repo files
while IFS= read -r -d '' file; do

    relative="${file#"$TMP_DIR/repo/"}"

    repo_files["$relative"]=1

    if [[ -f "$SCRIPT_DIR/$relative" ]]; then

        if ! cmp -s "$file" "$SCRIPT_DIR/$relative"; then
            file_status["$relative"]="updated"
        fi

    else

        file_status["$relative"]="new"

    fi

done < <(find "$TMP_DIR/repo" -type f -print0)

# Check local files
while IFS= read -r -d '' file; do

    relative="${file#"$SCRIPT_DIR/"}"

    local_files["$relative"]=1

done < <(
    find "$SCRIPT_DIR" -path "$SCRIPT_DIR/.git" -prune -o -type f -print0
)

# Remove old files
for file in "${!local_files[@]}"; do

    if [[ -z "${repo_files[$file]}" ]]; then

        file_status["$file"]="removed"

        rm -f "$SCRIPT_DIR/$file"

    fi

done

# Update everything except this script
while IFS= read -r -d '' file; do

    relative="${file#"$TMP_DIR/repo/"}"

    [[ "$relative" == "$SCRIPT_NAME" ]] && continue

    mkdir -p "$SCRIPT_DIR/$(dirname "$relative")"

    cp -f "$file" "$SCRIPT_DIR/$relative"

done < <(find "$TMP_DIR/repo" -type f -print0)

# Update this script
if [[ -f "$TMP_DIR/repo/$SCRIPT_NAME" ]]; then

    cp -f "$TMP_DIR/repo/$SCRIPT_NAME" "$SCRIPT_DIR/$SCRIPT_NAME"
    
    chmod +x "$SCRIPT_DIR/$SCRIPT_NAME"

fi

confirmed=0
while [ "$confirmed" = 0 ]; do
    modules=()
    display=()

    clear
    echo -e "
-------------------------------------------------------------------------
$(tput setaf 4)
             █████╗ ██████╗  ██████╗██╗  ██╗███████╗██████╗
            ██╔══██╗██╔══██╗██╔════╝██║  ██║██╔════╝██╔══██╗
            ███████║██████╔╝██║     ███████║█████╗  ██████╔╝
            ██╔══██║██╔══██╗██║     ██╔══██║██╔══╝  ██╔══██╗
            ██║  ██║██║  ██║╚██████╗██║  ██║███████╗██║  ██║
            ╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝
$(tput sgr0)
-------------------------------------------------------------------------
                          Configuration Toolkit
-------------------------------------------------------------------------"

    # Get arrows
    while IFS= read -r file; do
        modules+=("$file")

        name=$(grep '^# NAME:' "$file" | sed 's/# NAME: //')
        desc=$(grep '^# DESC:' "$file" | sed 's/# DESC: //')
        [ -z "$name" ] && name=$(basename "$file")
        [ -z "$desc" ] && desc="No description available"

        display+=("${name} - ${desc}")
    done < <(find "$QUIVER" -maxdepth 1 -type f | sort)

    if [ "${#display[@]}" -eq 0 ]; then
        show_error "No arrows found in the quiver"
        exit 1
    fi

    selected=$(checkbox "Select arrows to fire (Space)" "${display[@]}")
    echo

    if [ -z "$selected" ]; then
        show_error "You must select at least one arrow"
        sleep 0.5
        continue
    fi

    confirmed=$(confirm "Fire selected arrows?")
    echo
done


for index in $selected; do
    module="${modules[$index]}"

    echo "-------------------------------------------------------------------------"
    show_info "Firing $(basename "$module") arrow"

    if bash "$module"; then
        show_success "$(basename "$module") hit the target"
    else
        show_error "$(basename "$module") missed the target"
    fi
done

show_success "Done! All arrows have been fired"
show_info "Please reboot your system"
confirmed=$(confirm "Would you like to reboot now?")
[[ $confirmed == 1 ]] && reboot
[[ $confirmed == 0 ]] && exit
